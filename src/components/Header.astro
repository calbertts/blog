---
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">Carlos Alberto</a>
    <nav class="header-nav">
      <a href="/" class="nav-link" data-i18n="nav_essays">Ensayos</a>
      <a href="/about" class="nav-link" data-i18n="nav_about">Sobre</a>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar tema" data-i18n-aria="theme_toggle">◐</button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .header-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-light);
    transition: color 0.15s;
  }

  .nav-link:hover { color: var(--color-accent); }

  .theme-toggle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-text);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.3s;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
    transform: rotate(180deg);
  }

  :root[data-theme="dark"] .theme-toggle {
    transform: scaleX(-1);
  }

  :root[data-theme="dark"] .theme-toggle:hover {
    transform: scaleX(-1) rotate(180deg);
  }
</style>
