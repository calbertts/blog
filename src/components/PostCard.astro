---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, cover, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('es', {
  month: 'short', day: 'numeric', year: 'numeric'
});

const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);
---

{featured ? (
  <article class="featured-card">
    <a href={`/blog/${post.id}`} class="featured-link">
      <p class="featured-kicker" data-i18n="featured_label">Destacado</p>
      <div class="featured-grid">
        <div class="featured-text">
          <h2 class="featured-title">{title}</h2>
          <p class="featured-desc">{description}</p>
          <div class="featured-meta">
            <span data-i18n="reading_time" data-i18n-count={readingTime}>{readingTime} min de lectura</span>
            <span class="meta-dot">·</span>
            <time datetime={pubDate.toISOString()} data-date-short>{formattedDate}</time>
          </div>
        </div>
        {cover && (
          <div class="featured-cover">
            <img src={cover} alt={title} />
          </div>
        )}
      </div>
    </a>
  </article>
) : (
  <article class="post-row">
    <a href={`/blog/${post.id}`} class="row-link">
      <div class="row-text">
        <h3 class="row-title">{title}</h3>
        <div class="row-meta">
          <span data-i18n="reading_time" data-i18n-count={readingTime}>{readingTime} min de lectura</span>
          <span class="meta-dot">·</span>
          <time datetime={pubDate.toISOString()} data-date-short>{formattedDate}</time>
        </div>
      </div>
      <span class="row-moon" aria-hidden="true">◐</span>
    </a>
  </article>
)}

<style>
  /* ── Featured ── */
  .featured-card {
    padding-bottom: 8px;
  }

  .featured-kicker {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: 18px;
  }

  .featured-grid {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .featured-text {
    flex: 1;
    min-width: 0;
  }

  .featured-title {
    font-family: var(--font-body);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin-bottom: 14px;
    transition: color 0.2s;
  }

  .featured-link:hover .featured-title { color: var(--color-accent); }

  .featured-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-meta {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-text-lighter);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .featured-cover {
    flex-shrink: 0;
    width: 260px;
    height: 260px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .featured-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-link:hover .featured-cover img { transform: scale(1.03); }

  @media (max-width: 640px) {
    .featured-grid { flex-direction: column-reverse; gap: 20px; align-items: stretch; }
    .featured-cover { width: 100%; height: 200px; }
  }

  /* ── List row ── */
  .post-row {
    border-bottom: 1px solid var(--color-border);
  }

  .row-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 26px 2px;
  }

  .row-title {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .row-link:hover .row-title { color: var(--color-accent); }

  .row-meta {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-text-lighter);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .row-moon {
    font-family: var(--font-body);
    color: var(--color-accent);
    font-size: 1.125rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .row-link:hover .row-moon {
    opacity: 1;
    transform: translateX(0);
  }
</style>
