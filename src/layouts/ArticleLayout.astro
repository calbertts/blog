---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, cover, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString('es', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const readingTime = Math.ceil(post.body.split(/\s+/).length / 200);
const slug = post.id;
---

<BaseLayout
  title={`${title} — Carlos Alberto`}
  description={description}
  image={cover}
  pubDate={pubDate}
  isArticle={true}
>
  <Header />

  <main class="article-main">
    <div class="article-header">
      {tags.length > 0 && <p class="article-kicker">{tags[0]}</p>}
      <h1 class="article-title">{title}</h1>
      <p class="article-subtitle">{description}</p>
      <div class="article-meta">
        <span data-i18n="reading_time" data-i18n-count={readingTime}>{readingTime} min de lectura</span>
        <span class="meta-sep">·</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && (
          <>
            <span class="meta-sep">·</span>
            <span><span data-i18n="updated_label">Actualizado</span> <time datetime={updatedDate.toISOString()} data-date-short>{updatedDate.toLocaleDateString('es', { month: 'short', day: 'numeric', year: 'numeric' })}</time></span>
          </>
        )}
      </div>
    </div>

    <hr class="moon-divider article-divider" />

    <article class="article-body">
      <div class="prose">
        <slot />
      </div>

      <div class="article-actions">
        <button class="likes-btn" id="likes-btn" data-slug={slug} aria-label="Me gusta" data-i18n-aria="likes_aria">
          <span class="likes-moon" aria-hidden="true">◐</span>
          <span class="likes-count" id="likes-count">–</span>
          <span data-i18n="likes_aria">Me gusta</span>
        </button>

        <button class="share-btn" id="share-btn" data-url={Astro.url.href}>
          <span data-i18n="share_label">Compartir</span>
        </button>
      </div>
    </article>

    <div class="back-wrap">
      <a href="/" class="back-link" data-i18n="back_all_posts">← Todos los artículos</a>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const API = '/api';

  async function initViews() {
    const slug = document.getElementById('likes-btn')?.dataset.slug;
    if (!slug) return;
    // Track view once per session
    const key = `viewed_${slug}`;
    if (!sessionStorage.getItem(key)) {
      sessionStorage.setItem(key, '1');
      fetch(`${API}/views/${slug}`, { method: 'POST' }).catch(() => {});
    }
  }

  async function initLikes() {
    const btn = document.getElementById('likes-btn') as HTMLButtonElement;
    const countEl = document.getElementById('likes-count') as HTMLSpanElement;
    if (!btn) return;

    const slug = btn.dataset.slug!;

    try {
      const res = await fetch(`${API}/likes/${slug}`);
      const data = await res.json();
      countEl.textContent = data.count;
      if (data.liked) btn.classList.add('liked');
    } catch {
      countEl.textContent = '0';
    }

    btn.addEventListener('click', async () => {
      const isLiked = btn.classList.contains('liked');
      btn.classList.toggle('liked');

      try {
        const res = await fetch(`${API}/likes/${slug}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: isLiked ? 'unlike' : 'like' }),
        });
        const data = await res.json();
        countEl.textContent = data.count;
        // Sync with server state
        if (data.liked) btn.classList.add('liked');
        else btn.classList.remove('liked');
      } catch {
        btn.classList.toggle('liked'); // revert
      }
    });
  }

  function initShare() {
    const btn = document.getElementById('share-btn') as HTMLButtonElement;
    if (!btn) return;
    const label = btn.querySelector('span[data-i18n]') as HTMLSpanElement;
    const originalText = label?.textContent ?? 'Compartir';

    btn.addEventListener('click', async () => {
      const url = btn.dataset.url!;
      const title = document.title;

      if (navigator.share) {
        try { await navigator.share({ title, url }); } catch {}
        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = 'Copiado ✓';
          setTimeout(() => { label.textContent = originalText; }, 1800);
        }
      } catch {}
    });
  }

  initViews();
  initLikes();
  initShare();
</script>

<style>
  .article-main {
    padding: 72px 24px 0;
  }

  .article-header {
    position: relative;
    max-width: var(--header-width);
    margin: 0 auto;
    overflow: hidden;
  }

  .article-header::before {
    content: '';
    position: absolute;
    top: -140px;
    right: -140px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    opacity: 0.14;
    pointer-events: none;
  }

  .article-kicker {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    text-align: center;
    margin-bottom: 20px;
  }

  .article-title {
    font-family: var(--font-body);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--color-text);
    text-align: center;
    margin-bottom: 22px;
  }

  .article-subtitle {
    font-family: var(--font-body);
    font-size: 1.1875rem;
    font-weight: 400;
    color: var(--color-text-light);
    line-height: 1.6;
    text-align: center;
    max-width: 620px;
    margin: 0 auto 26px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }

  .article-meta span, .article-meta time {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-text-lighter);
  }

  .meta-sep { color: var(--color-border); }

  .article-divider {
    max-width: var(--header-width);
    margin: 0 auto 56px;
  }

  .article-body {
    max-width: var(--reading-width);
    margin: 0 auto;
  }

  /* Prose */
  .prose {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .prose :global(p:first-of-type::first-letter) {
    font-family: var(--font-body);
    font-size: 3.6rem;
    line-height: 0.8;
    font-weight: 500;
    float: left;
    padding: 6px 10px 0 0;
    color: var(--color-accent-text);
  }

  .prose :global(h2) {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2.5em 0 0.75em;
    line-height: 1.3;
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2em 0 0.5em;
    line-height: 1.35;
    color: var(--color-text);
  }

  .prose :global(p) { margin-bottom: 1.7em; }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-border);
    transition: text-decoration-color 0.15s;
  }

  .prose :global(a:hover) { text-decoration-color: var(--color-accent); }

  .prose :global(strong) { font-weight: 600; }

  .prose :global(em) { font-style: italic; }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    margin: 2em 0;
    padding: 2px 0 2px 28px;
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  .prose :global(blockquote p) { margin-bottom: 0; }

  .prose :global(ul), .prose :global(ol) {
    margin: 0.5em 0 1.5em 1.75em;
  }

  .prose :global(li) { margin-bottom: 0.5em; }

  .prose :global(hr) {
    border: none;
    text-align: center;
    margin: 3em 0;
  }

  .prose :global(hr::after) {
    content: '◐';
    font-size: 1.125rem;
    color: var(--color-accent);
    opacity: 0.7;
  }

  .prose :global(code) {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--color-text);
  }

  .prose :global(pre) {
    background: var(--color-surface);
    color: var(--color-text);
    padding: 24px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 2em 0;
    font-size: 0.875rem;
    line-height: 1.7;
    border: 1px solid var(--color-border);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose :global(img) {
    border-radius: 3px;
    margin: 2em auto;
  }

  .prose :global(figcaption) {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--color-text-lighter);
    text-align: center;
    margin-top: 8px;
  }

  /* Actions */
  .article-actions {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .likes-btn, .share-btn {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 10px 20px;
    cursor: pointer;
    color: var(--color-text-light);
    transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }

  .likes-btn:hover, .share-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .likes-moon {
    font-family: var(--font-body);
    color: var(--color-text-lighter);
    transition: color 0.2s;
  }

  .likes-btn.liked {
    border-color: var(--color-accent);
    background: var(--color-surface);
    color: var(--color-accent-text);
  }

  .likes-btn.liked .likes-moon { color: var(--color-accent-text); }

  /* Back */
  .back-wrap {
    max-width: var(--reading-width);
    margin: 48px auto 0;
    padding: 28px 24px;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .back-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: var(--color-text-light);
    transition: color 0.15s;
  }

  .back-link:hover { color: var(--color-accent); }

  @media (max-width: 640px) {
    .article-header::before { width: 260px; height: 260px; top: -80px; right: -80px; }
    .prose { font-size: 1.125rem; }
  }
</style>
