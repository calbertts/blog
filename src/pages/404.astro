---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Página no encontrada">
  <Header />
  <main class="error-main">
    <div class="error-content">
      <p class="error-code" aria-hidden="true">◐</p>
      <h1 class="error-title" data-i18n="not_found_title">Página no encontrada</h1>
      <a href="/" class="error-link" data-i18n="back_home">← Volver al inicio</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .error-main {
    padding: 80px 24px;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
  }
  .error-content {
    max-width: var(--reading-width);
    margin: 0 auto;
    text-align: center;
  }
  .error-code {
    font-family: var(--font-body);
    font-size: 4rem;
    color: var(--color-accent);
    opacity: 0.6;
    line-height: 1;
    margin-bottom: 24px;
  }
  .error-title {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1.5rem;
    margin-bottom: 32px;
    color: var(--color-text-light);
  }
  .error-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: var(--color-text-light);
    transition: color 0.15s;
  }
  .error-link:hover { color: var(--color-accent); }
</style>
